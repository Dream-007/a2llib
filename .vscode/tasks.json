{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "xcp_master: cmake configure",
            "type": "shell",
            "command": "/home/shiheping/.local/lib/python3.8/site-packages/cmake/data/bin/cmake",
            "args": [
                "-S", "${workspaceFolder}/xcp_master",
                "-B", "${workspaceFolder}/xcp_master/build",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "problemMatcher": [],
            "group": "build",
            "detail": "Configure the xcp_master CMake project in Debug mode."
        },
        {
            "label": "xcp_master: build",
            "type": "shell",
            "command": "/home/shiheping/.local/lib/python3.8/site-packages/cmake/data/bin/cmake",
            "args": [
                "--build", "${workspaceFolder}/xcp_master/build",
                "-j", "4"
            ],
            "problemMatcher": [ "$gcc" ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [ "xcp_master: cmake configure" ],
            "detail": "Build xcp_master library + xcp_master_example with debug symbols."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++-13 生成活动文件",
            "command": "/usr/bin/g++-13",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [ "$gcc" ],
            "detail": "Single-file build (legacy)."
        }
    ]
}
